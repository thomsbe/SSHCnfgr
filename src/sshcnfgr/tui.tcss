#body {
  height: 1fr;
}

#left {
  width: 45%;
  padding: 1;
  border: round $primary;
}

#right {
  width: 55%;
  padding: 1;
  border: round $accent;
}

#list_actions,
#identity_actions,
#group_identity_actions,
#detail_actions {
  height: auto;
  margin-top: 1;
}

#hosts_table,
#identities_table {
  height: 1fr;
}

Input {
  margin-top: 1;
}

#status {
  margin-top: 1;
  padding: 1;
  border: round $success;
  color: $text;
}

#dedup_toolbar {
  height: auto;
  padding: 0 1;
  align-vertical: middle;
}

#dedup_title {
  width: 1fr;
  text-style: bold;
}

#dedup_body {
  height: 1fr;
}

#dedup_left {
  width: 40%;
  padding: 1;
  border: round $primary;
}

#dedup_right {
  width: 60%;
  padding: 1;
  border: round $accent;
}

#dedup_groups_table {
  height: 1fr;
}

#dedup_members_table {
  height: 8;
  margin-bottom: 1;
}

#dedup_conflicts_container {
  height: auto;
  margin-bottom: 1;
}

.dedup-hint {
  color: $text-muted;
  margin: 1 0;
}

#dedup_preview {
  margin-top: 1;
  padding: 1;
  border: round $primary;
  color: $text;
}

#dedup_left_actions,
#dedup_merge_actions {
  height: auto;
  margin-top: 1;
}

#dedup_status {
  margin-top: 1;
  padding: 1;
  border: round $success;
  color: $text;
}
